# Environment Configuration Template
# Copy this file to .env and update the values according to your setup

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary database connection string (required)
# Format: postgresql://username:password@host:port/database_name
# Example for Neon Database: postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname
DATABASE_URL="postgresql://username:password@host:port/database_name"

# Individual database connection parameters (auto-generated by Replit/Neon)
# These are typically provided by your database service
PGHOST="your-postgres-host.example.com"
PGPORT="5432"
PGUSER="your-database-username"
PGPASSWORD="your-secure-password"
PGDATABASE="your-database-name"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment setting (development | production | test)
NODE_ENV="development"

# Server port (default: 5000)
# Note: Replit automatically assigns a port, this is for local development
PORT="5000"

# Application base URL (used for absolute links and redirects)
# Development: http://localhost:5000
# Production: https://your-app.replit.app
BASE_URL="http://localhost:5000"

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================

# Session secret key for signing session cookies (required in production)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECURITY: Never commit the actual secret to version control
SESSION_SECRET="your-super-secure-session-secret-minimum-32-characters"

# Session configuration
SESSION_NAME="wang-sam-mo-session"
SESSION_MAX_AGE="86400000"  # 24 hours in milliseconds
SESSION_SECURE="false"      # Set to true in production with HTTPS
SESSION_HTTP_ONLY="true"    # Prevent XSS attacks

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
# Development: http://localhost:3000,http://localhost:5000
# Production: https://your-domain.com
CORS_ORIGINS="http://localhost:5000"

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX="100"           # Maximum requests per window

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Email service configuration (for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="Wang Sam Mo Jobs <noreply@your-domain.com>"

# File upload configuration
# UPLOAD_MAX_SIZE="5242880"     # 5MB in bytes
# UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Third-party API keys (if needed for integrations)
# GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
# ANALYTICS_ID="your-analytics-tracking-id"

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Logging configuration
LOG_LEVEL="info"               # error | warn | info | debug
LOG_FORMAT="combined"          # combined | common | dev | short | tiny

# Development debugging
# Enable debug mode for specific modules
# DEBUG="express:*,drizzle:*"

# Hot reload configuration
# VITE_HMR_PORT="24678"
# VITE_HMR_HOST="localhost"

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Production-specific settings (uncomment and configure for production)

# Database connection pooling
# DB_POOL_MIN="2"
# DB_POOL_MAX="10"
# DB_IDLE_TIMEOUT="30000"

# Performance monitoring
# MONITORING_ENABLED="true"
# METRICS_PORT="9090"

# SSL/TLS configuration
# SSL_CERT_PATH="/path/to/certificate.crt"
# SSL_KEY_PATH="/path/to/private.key"

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
FEATURE_USER_REGISTRATION="true"
FEATURE_JOB_APPLICATIONS="true"
FEATURE_COMPANY_PROFILES="true"
FEATURE_EMAIL_NOTIFICATIONS="false"
FEATURE_ADMIN_PANEL="false"

# Language and localization
DEFAULT_LANGUAGE="th"          # th | en
SUPPORTED_LANGUAGES="th,en"

# =============================================================================
# VALIDATION AND TESTING
# =============================================================================

# Test database (for running tests)
# TEST_DATABASE_URL="postgresql://username:password@host:port/test_database"

# Mock external services in development
# MOCK_EMAIL_SERVICE="true"
# MOCK_FILE_UPLOAD="true"

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================

# 1. Never commit real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate secrets regularly, especially SESSION_SECRET
# 4. Enable HTTPS in production (SESSION_SECURE="true")
# 5. Use environment-specific values for each deployment
# 6. Limit database user permissions to minimum required
# 7. Monitor and log security events
# 8. Keep dependencies updated for security patches

# =============================================================================
# QUICK START CHECKLIST
# =============================================================================

# ✅ 1. Copy this file to .env
# ✅ 2. Set DATABASE_URL with your database credentials
# ✅ 3. Generate and set SESSION_SECRET
# ✅ 4. Configure NODE_ENV (development/production)
# ✅ 5. Set BASE_URL for your environment
# ✅ 6. Test connection with: npm run db:push
# ✅ 7. Start development server: npm run dev

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common issues and solutions:

# Database connection fails:
# - Verify DATABASE_URL format and credentials
# - Check if database server is running and accessible
# - Ensure firewall allows connections on database port
# - Test connection with: psql $DATABASE_URL

# Session issues:
# - Ensure SESSION_SECRET is set and sufficiently long
# - Check SESSION_SECURE setting matches your HTTPS setup
# - Clear browser cookies if experiencing login issues

# Port conflicts:
# - Change PORT value if 5000 is already in use
# - Check for other services running on the same port
# - Use netstat or lsof to identify port usage

# Environment not loading:
# - Ensure .env file is in project root directory
# - Check file permissions (should be readable by application)
# - Verify no syntax errors in .env file (no spaces around =)